<Window x:Class="LinuxControlPanel.ConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Linux Control Panel — 접속"
        Width="1000" Height="680" MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Malgun Gothic"
        Background="{StaticResource AppBackgroundBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Grid Margin="20" RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Linux Control Panel" Foreground="{StaticResource TextBrush}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                       Text="SSH 로 리눅스 PC 에 접속해 상태를 보고 명령을 실행합니다. 주소록에서 고르거나 새 대상을 입력하세요." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="340,20,*">

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="주소록" />

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="DeleteEntryButton" Content="선택 삭제" Width="90" Height="28"
                                IsEnabled="False" Click="DeleteEntryButton_Click" />
                        <TextBlock x:Name="AddressBookCountText" Style="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>

                    <Grid>
                        <ListBox x:Name="AddressBookList"
                                 Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 SelectionChanged="AddressBookList_SelectionChanged"
                                 MouseDoubleClick="AddressBookList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,6">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Target}" Style="{StaticResource Muted}" />
                                        <TextBlock Style="{StaticResource Muted}">
                                            <Run Text="{Binding AuthText, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding LastConnectedText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="EmptyBookText" Style="{StaticResource Muted}"
                                   TextWrapping="Wrap" VerticalAlignment="Top" Visibility="Collapsed"
                                   Text="아직 저장된 접속 기록이 없습니다. 오른쪽에 주소와 계정을 입력해 접속하면 이 목록에 남습니다." />
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="접속 정보" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="표시 이름 (비워 두면 주소를 씁니다)" />
                        <TextBox x:Name="DisplayNameBox" Height="30" Margin="0,0,0,12" />

                        <Grid ColumnDefinitions="*,12,110">
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="호스트 주소 또는 IP" />
                                <TextBox x:Name="HostBox" Height="30" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="포트" />
                                <TextBox x:Name="PortBox" Height="30" Text="22" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,4" Text="사용자 이름" />
                        <TextBox x:Name="UserBox" Height="30" />

                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,4" Text="인증 방식" />
                        <ComboBox x:Name="AuthCombo" Height="30" SelectedIndex="0" SelectionChanged="AuthCombo_SelectionChanged">
                            <ComboBoxItem Content="비밀번호" />
                            <ComboBoxItem Content="개인키 파일" />
                        </ComboBox>

                        <StackPanel x:Name="PasswordPanel" Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="비밀번호" />
                            <PasswordBox x:Name="PasswordBoxInput" Height="30" />
                        </StackPanel>

                        <StackPanel x:Name="KeyPanel" Margin="0,12,0,0" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="개인키 파일 (OpenSSH / PuTTY)" />
                            <Grid ColumnDefinitions="*,8,100">
                                <TextBox x:Name="KeyPathBox" Grid.Column="0" Height="30" />
                                <Button Grid.Column="2" Content="찾아보기" Height="30" Click="BrowseKeyButton_Click" />
                            </Grid>
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,4" Text="키 암호 (없으면 비워 두세요)" />
                            <PasswordBox x:Name="KeyPassphraseBox" Height="30" />
                        </StackPanel>

                        <CheckBox x:Name="SaveSecretCheck" Margin="0,14,0,0" Foreground="{StaticResource TextBrush}"
                                  Content="이 PC 에 비밀 값 저장 (Windows DPAPI 로 암호화)" />

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="ConnectButton" Content="접속" Width="120" Height="34" IsDefault="True"
                                    Click="ConnectButton_Click" />
                            <Button x:Name="CancelConnectButton" Content="취소" Width="90" Height="34" Margin="10,0,0,0"
                                    IsEnabled="False" Click="CancelConnectButton_Click" />
                        </StackPanel>

                        <ProgressBar x:Name="BusyBar" Height="4" Margin="0,14,0,0" IsIndeterminate="True" Visibility="Collapsed" />

                        <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock x:Name="StorePathText" Grid.Row="2" Style="{StaticResource Muted}" Margin="2,14,0,0" TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
